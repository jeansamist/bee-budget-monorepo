# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with `node ace generate:key`
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (matches docker-compose.yaml at the repo root)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=bee_budget
DB_SSL=false

# Mail (Mailpit from docker-compose.yaml, inbox at http://localhost:8025)
MAIL_MAILER=smtp
MAIL_FROM_NAME=BeeBudget
MAIL_FROM_ADDRESS=no-reply@beebudget.app
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=mailpit
SMTP_PASSWORD=mailpit

# Send an OTP to verify the email on sign-up (set to false where emails
# can't be sent, e.g. Render free tier)
EMAIL_VERIFICATION_ENABLED=true

# Frontend (used to build links in emails)
FRONTEND_APP_URL=http://localhost:3000

#--------------------------------------------------------------------
# CORS — comma-separated origin allowlist, enforced in production.
# Ignored in development, where every origin is allowed.
#--------------------------------------------------------------------
# CORS_ORIGIN=https://bee-budget.vercel.app